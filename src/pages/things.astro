---
import { things, italicCategories } from "../data/things";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>things — nick lam</title>
		<meta name="description" content="a running list of things nick lam likes." />
	</head>
	<body>
		<div class="page">
			<div class="content">
				<header class="intro">
					<a class="back" href="/">nick lam</a>
					<h1>things</h1>
				</header>

				<main>
					{Object.entries(things).map(([heading, items]) => (
						<section aria-labelledby={`${heading.replace(/\s+/g, "-")}-heading`}>
							<h2 id={`${heading.replace(/\s+/g, "-")}-heading`}>{heading}</h2>
							<ul class="things-list">
								{items.map((item) => (
									<li
										class="thing-item"
										data-image={item.image}
										data-caption={item.caption}
										tabindex={item.image ? 0 : undefined}
									>
										<p
											class="thing-name"
											class:list={[{ roman: !italicCategories.has(heading) }]}
										>
											{item.url ? <a href={item.url}>{item.name}</a> : item.name}
											{item.image && (
												<span class="note-marker" aria-hidden="true">&middot;</span>
											)}
										</p>
										{(item.meta || item.note) && (
											<p class="thing-detail">
												{item.meta}
												{item.meta && item.note && " · "}
												{item.note}
											</p>
										)}
									</li>
								))}
							</ul>
						</section>
					))}
				</main>
			</div>

			<aside class="preview" aria-hidden="true">
				<img class="preview-image" alt="" hidden />
				<p class="preview-note"></p>
			</aside>
		</div>

		<script>
			const items = document.querySelectorAll<HTMLLIElement>(".thing-item");
			const preview = document.querySelector<HTMLElement>(".preview");
			const previewImage = document.querySelector<HTMLImageElement>(".preview-image");
			const previewNote = document.querySelector<HTMLElement>(".preview-note");

			function show(li: HTMLLIElement) {
				const image = li.dataset.image;
				const caption = li.dataset.caption ?? "";

				if (!image && !caption) return;

				if (image && previewImage) {
					previewImage.src = image;
					previewImage.hidden = false;
				} else if (previewImage) {
					previewImage.hidden = true;
				}

				if (previewNote) {
					previewNote.textContent = caption;
					previewNote.hidden = !caption;
				}
				preview?.classList.add("visible");
			}

			function hide() {
				preview?.classList.remove("visible");
			}

			items.forEach((li) => {
				li.addEventListener("mouseenter", () => show(li));
				li.addEventListener("mouseleave", hide);
				li.addEventListener("focusin", () => show(li));
				li.addEventListener("focusout", hide);
			});
		</script>
	</body>
</html>

<style>
	:global(html) {
		box-sizing: border-box;
	}
	:global(*),
	:global(*::before),
	:global(*::after) {
		box-sizing: inherit;
	}
	:global(body) {
		margin: 0;
		background: #f7f6f2;
		color: #000;
		font-family: "Times New Roman", Times, "Liberation Serif", "Nimbus Roman", serif;
		font-size: 0.8125rem;
		line-height: 1.5;
		-webkit-font-smoothing: antialiased;
	}

	.page {
		max-width: 65rem;
		margin: 0 auto;
		padding: 2rem 2rem 2.5rem;
		display: grid;
		grid-template-columns: 1fr 18rem;
		column-gap: 3rem;
		align-items: start;
	}

	.content {
		max-width: 45rem;
	}

	.preview {
		position: sticky;
		top: 2rem;
	}

	.preview-image {
		display: block;
		width: 100%;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.preview-image[hidden] {
		display: none;
	}

	.preview.visible .preview-image:not([hidden]) {
		opacity: 1;
	}

	.preview-note {
		margin: 0.5rem 0 0;
		font-size: 0.75rem;
		font-style: italic;
		color: #6b6b64;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.preview.visible .preview-note {
		opacity: 1;
	}

	.intro {
		margin-bottom: 1.5rem;
	}

	.back {
		display: inline-block;
		font-size: 0.6875rem;
		color: #6b6b64;
		margin-bottom: 0.5rem;
	}

	h1 {
		font-size: 1.125rem;
		font-weight: 400;
		margin: 0;
	}

	main {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	h2 {
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.05em;
		color: #6b6b64;
		margin: 0 0 0.25rem;
	}

	.things-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.things-list li {
		width: fit-content;
		max-width: 100%;
		margin-bottom: 0.375rem;
	}
	.things-list li:last-child {
		margin-bottom: 0;
	}

	.thing-name {
		font-size: 0.875rem;
		font-style: italic;
		font-weight: 400;
		color: #000;
		margin: 0;
		line-height: 1.4;
	}

	.thing-name.roman {
		font-style: normal;
	}

	.note-marker {
		display: none;
		margin-left: 0.2rem;
		font-size: 1.125rem;
		line-height: 1;
		vertical-align: middle;
		color: #6b6b64;
	}

	@media (min-width: 60.0625rem) {
		.note-marker {
			display: inline-block;
		}
	}

	.thing-detail {
		font-size: 0.75rem;
		font-style: normal;
		color: #000;
		margin: 0.15rem 0 0;
	}

	a {
		color: #000;
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
		text-decoration-color: currentColor;
		text-underline-offset: 3px;
	}

	@media (max-width: 60rem) {
		.page {
			grid-template-columns: 1fr;
			max-width: 45rem;
		}
		.preview {
			display: none;
		}
	}

	@media (max-width: 30rem) {
		.page {
			padding: 1.5rem 1.25rem 2rem;
		}
		.intro {
			margin-bottom: 1.25rem;
		}
		main {
			gap: 1.5rem;
		}
	}
</style>
