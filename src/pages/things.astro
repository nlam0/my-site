---
import { things, italicCategories } from "../data/things";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>things — nick lam</title>
		<meta name="description" content="a running list of things nick lam likes." />
	</head>
	<body>
		<div class="page">
			<div class="content">
				<header class="intro">
					<a class="back" href="/">nick lam</a>
					<h1>things</h1>
				</header>

				<main>
					{Object.entries(things).map(([heading, items]) => (
						<section aria-labelledby={`${heading.replace(/\s+/g, "-")}-heading`}>
							<h2 id={`${heading.replace(/\s+/g, "-")}-heading`}>{heading}</h2>
							<ul class="things-list">
								{items.map((item) => (
									<li
										class="thing-item"
										data-image={item.image}
										data-caption={item.caption}
										tabindex={item.image ? 0 : undefined}
									>
										<p
											class="thing-name"
											class:list={[{ roman: !italicCategories.has(heading) }]}
											style={item.color ? `color: ${item.color}` : undefined}
										>
											{item.url ? <a href={item.url}>{item.name}</a> : item.name}
											{item.image && (
												<span class="note-marker" aria-hidden="true">&middot;</span>
											)}
										</p>
										{(item.meta || item.note) && (
											<p class="thing-detail">
												{item.meta}
												{item.meta && item.note && " · "}
												{item.note}
											</p>
										)}
									</li>
								))}
							</ul>
						</section>
					))}
				</main>
			</div>

			<aside class="preview" aria-hidden="true">
				<img class="preview-image" alt="" hidden />
				<p class="preview-note"></p>
			</aside>
		</div>

		<script>
			const items = document.querySelectorAll<HTMLLIElement>(".thing-item");
			const preview = document.querySelector<HTMLElement>(".preview");
			const previewImage = document.querySelector<HTMLImageElement>(".preview-image");
			const previewNote = document.querySelector<HTMLElement>(".preview-note");

			// deterministic pseudo-random in [0, 1), seeded by string so a given
			// item always lands in the same spot rather than jumping around
			function seededRandom(seed: string) {
				let hash = 0;
				for (let i = 0; i < seed.length; i++) {
					hash = (hash * 31 + seed.charCodeAt(i)) | 0;
				}
				return (hash >>> 0) / 4294967295;
			}

			function positionPreview(li: HTMLLIElement) {
				if (!preview) return;

				const width = preview.offsetWidth || 288;
				const vw = window.innerWidth;

				if (li.dataset.image === "/images/things/dinner-party.jpg") {
					preview.style.left = `${vw - width - 96}px`;
					preview.style.top = "96px";
					return;
				}

				const seed = "v2:" + (li.dataset.image ?? li.textContent ?? "");
				const hRand = seededRandom(seed + "h");
				const vRand = seededRandom(seed + "v");
				const jitterX = (seededRandom(seed + "jx") - 0.5) * 40;
				const jitterY = (seededRandom(seed + "jy") - 0.5) * 40;

				const vh = window.innerHeight;

				// horizontal range: from roughly a third across the screen to the
				// right edge, so previews cluster nearer the middle than the edge
				const minLeft = vw * 0.3;
				const maxLeft = Math.max(minLeft, Math.min(vw - width - 32, vw * 0.68));
				let left = minLeft + (maxLeft - minLeft) * hRand + jitterX;

				// vertical range: from near the top down past the midpoint of the
				// viewport, so previews aren't all pinned at the same height
				const minTop = 80;
				const maxTop = Math.max(minTop, vh * 0.6);
				let top = minTop + (maxTop - minTop) * vRand + jitterY;

				left = Math.min(Math.max(left, 16), vw - width - 16);
				top = Math.min(Math.max(top, 16), vh - 140);

				preview.style.left = `${left}px`;
				preview.style.top = `${top}px`;
			}

			function show(li: HTMLLIElement) {
				const image = li.dataset.image;
				const caption = li.dataset.caption ?? "";

				if (!image && !caption) return;

				if (image && previewImage) {
					previewImage.src = image;
					previewImage.hidden = false;
				} else if (previewImage) {
					previewImage.hidden = true;
				}

				if (previewNote) {
					previewNote.textContent = caption;
					previewNote.hidden = !caption;
				}
				positionPreview(li);
				preview?.classList.add("visible");
			}

			function hide() {
				preview?.classList.remove("visible");
			}

			items.forEach((li) => {
				li.addEventListener("mouseenter", () => show(li));
				li.addEventListener("mouseleave", hide);
				li.addEventListener("focusin", () => show(li));
				li.addEventListener("focusout", hide);
			});
		</script>
	</body>
</html>

<style>
	:global(html) {
		box-sizing: border-box;
	}
	:global(*),
	:global(*::before),
	:global(*::after) {
		box-sizing: inherit;
	}
	:global(body) {
		margin: 0;
		background: #f7f6f2;
		color: #000;
		font-family: "Times New Roman", Times, "Liberation Serif", "Nimbus Roman", serif;
		font-size: 0.8125rem;
		line-height: 1.5;
		-webkit-font-smoothing: antialiased;
	}

	.page {
		max-width: 65rem;
		margin: 0 auto;
		padding: 2rem 2rem 2.5rem;
		display: grid;
		grid-template-columns: 1fr 18rem;
		column-gap: 3rem;
		align-items: start;
	}

	.content {
		max-width: 45rem;
	}

	.preview {
		position: fixed;
		top: 2rem;
		left: calc(100% - 20rem);
		width: 18rem;
		pointer-events: none;
		z-index: 10;
	}

	.preview-image {
		display: block;
		width: 100%;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.preview-image[hidden] {
		display: none;
	}

	.preview.visible .preview-image:not([hidden]) {
		opacity: 1;
	}

	.preview-note {
		margin: 0.5rem 0 0;
		font-size: 0.75rem;
		font-style: italic;
		color: #6b6b64;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.preview.visible .preview-note {
		opacity: 1;
	}

	.intro {
		margin-bottom: 1.5rem;
	}

	.back {
		display: inline-block;
		font-size: 0.6875rem;
		color: #6b6b64;
		margin-bottom: 0.5rem;
	}

	h1 {
		font-size: 1.125rem;
		font-weight: 400;
		margin: 0;
	}

	main {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	h2 {
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.05em;
		color: #6b6b64;
		margin: 0 0 0.25rem;
	}

	.things-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.things-list li {
		width: fit-content;
		max-width: 100%;
		margin-bottom: 0.375rem;
	}
	.things-list li:last-child {
		margin-bottom: 0;
	}

	.thing-name {
		font-size: 0.875rem;
		font-style: italic;
		font-weight: 400;
		color: #000;
		margin: 0;
		line-height: 1.4;
	}

	.thing-name.roman {
		font-style: normal;
	}

	.note-marker {
		display: none;
		margin-left: 0.2rem;
		font-size: 1.125rem;
		line-height: 1;
		vertical-align: middle;
		color: #6b6b64;
	}

	@media (min-width: 60.0625rem) {
		.note-marker {
			display: inline-block;
		}
	}

	.thing-detail {
		font-size: 0.75rem;
		font-style: normal;
		color: #000;
		margin: 0.15rem 0 0;
	}

	a {
		color: #000;
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
		text-decoration-color: currentColor;
		text-underline-offset: 3px;
	}

	@media (max-width: 60rem) {
		.page {
			grid-template-columns: 1fr;
			max-width: 45rem;
		}
		.preview {
			display: none;
		}
	}

	@media (max-width: 30rem) {
		.page {
			padding: 1.5rem 1.25rem 2rem;
		}
		.intro {
			margin-bottom: 1.25rem;
		}
		main {
			gap: 1.5rem;
		}
	}
</style>
