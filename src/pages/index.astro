---
import { recently } from "../data/recently";

const nowItems = [
	"new york, ny",
	"reading outline by rachel cusk",
	"thinking about cities",
	"rip kusama",
];

const eventuallyItems = [
	"a longer piece of writing",
	"a company",
	"somewhere new",
];

const email = "n@nicklam.co";
const lastEdited = "08.29.2026";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>nick lam</title>
		<meta name="description" content="personal site of nick lam." />
	</head>
	<body>
		<div class="page">
			<header class="masthead">
				<h1>nick lam<span class="birth">b. 2004</span></h1>
				<p class="description">
					working on a few things.
				</p>

				<section aria-labelledby="now-heading">
					<h2 id="now-heading">currently</h2>
					<ul class="now-list">
						{nowItems.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</section>

				<section aria-labelledby="eventually-heading">
					<h2 id="eventually-heading">eventually</h2>
					<ul class="now-list">
						{eventuallyItems.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</section>

				<section aria-label="email">
					<p><a href={`mailto:${email}`}>{email}</a></p>
				</section>
			</header>

			<main>
				<section aria-labelledby="work-heading">
					<h2 id="work-heading">recently</h2>
					<p class="work-sentence">
						{recently.map((item) => (
							<>
								{item.verb}{" "}
								{item.prefix && <>{item.prefix}{" "}</>}
								{item.href ? <a href={item.href}>{item.title}</a> : item.title}
								{item.descriptor && <>, {item.descriptor}</>}
								{item.suffix && <> {item.suffix}</>}
								{item.date && <> <sub class="date">({item.date})</sub></>}
								{"; "}
							</>
						))}
						and other <a href="/things">things</a>.
					</p>
				</section>
			</main>
		</div>

		<footer class="colophon">last edited {lastEdited}</footer>
	</body>
</html>

<style>
	:global(html) {
		box-sizing: border-box;
	}
	:global(*),
	:global(*::before),
	:global(*::after) {
		box-sizing: inherit;
	}
	:global(body) {
		margin: 0;
		background: #f7f6f2;
		color: #000;
		font-family: "Times New Roman", Times, "Liberation Serif", "Nimbus Roman", serif;
		font-size: 0.8125rem;
		line-height: 1.5;
		-webkit-font-smoothing: antialiased;
	}

	.page {
		max-width: 76rem;
		margin: 0 auto;
		padding: 3rem 2rem 4rem;
		display: grid;
		grid-template-columns: 15rem 1fr;
		column-gap: 4rem;
		align-items: start;
	}

	.masthead {
		position: sticky;
		top: 3rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	h1 {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		font-size: 1.25rem;
		font-weight: 400;
		margin: 0;
	}

	.birth {
		font-size: 0.6875rem;
		font-style: italic;
		letter-spacing: 0.02em;
		color: #6b6b64;
	}

	.description {
		margin: 0;
		color: #000;
	}

	main {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		max-width: 42rem;
		margin-top: 7rem;
	}

	h2 {
		font-size: 0.8125rem;
		font-weight: 700;
		color: #000;
		margin: 0 0 0.25rem;
	}

	.now-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.now-list li {
		margin-bottom: 0.25rem;
	}
	.now-list li:last-child {
		margin-bottom: 0;
	}

	.work-sentence {
		margin: 0;
		font-size: 0.8125rem;
		line-height: 1.85;
	}

	.work-sentence a {
		color: inherit;
	}

	.work-sentence .date {
		color: #6b6b64;
		font-size: 0.6875rem;
		font-variant-numeric: tabular-nums;
		vertical-align: sub;
	}

	.colophon {
		max-width: 76rem;
		margin: 0 auto;
		padding: 0 2rem 2.5rem;
		color: #6b6b64;
		font-size: 0.6875rem;
		font-style: italic;
	}

	.colophon a {
		color: inherit;
	}

	a {
		color: #000;
		text-decoration-color: #000;
		text-underline-offset: 3px;
	}

	@media (max-width: 60rem) {
		.page {
			grid-template-columns: 1fr;
			row-gap: 2.5rem;
		}
		.masthead {
			position: static;
		}
		main {
			margin-top: 0;
		}
	}

	@media (max-width: 30rem) {
		.page {
			padding: 2rem 1.25rem 2.5rem;
			row-gap: 2rem;
		}
		main {
			gap: 2rem;
		}
	}
</style>
